{
  "name": "pwa-profiles-api",
  "main": "worker/entrypoint.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://applauncher.tannervoas.workers.dev,https://ciyan.tannervoas.workers.dev,https://pwa-git-api.tannervoas.workers.dev" },
  "durable_objects": { "bindings": [ { "name": "ACCOUNTS", "class_name": "AccountCoordinator" } ] },
  "migrations": [ { "tag": "v1", "new_sqlite_classes": [ "AccountCoordinator" ] } ]
}
